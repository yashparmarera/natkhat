# Copy to local.env for local runs. Placeholders only; never commit real values.
# Vercel: set these in Project Settings > Environment Variables (Production and Preview).

# --- Required on Vercel ---
# Supabase transaction pooler string (port 6543)
DATABASE_URL="postgres://postgres.[PROJECT-ID]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Used only for admin sign-in. Falls back to VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Public, exposed to the browser at build time
VITE_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Local / CI only. Do NOT set on Vercel ---
# USE_LOCAL_SQLITE="true"
# SQLITE_DB_PATH="./data/natkhat.db"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"
# EXPECTED_SUPABASE_PROJECT_REF="your-project-ref"
# MIGRATION_CONFIRM="your-project-ref"
